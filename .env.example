# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site URL — used for auth redirects (email confirmation, password recovery)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5

# Sentry (Phase 10)
SENTRY_DSN=your_sentry_dsn

# Stripe billing (D-042 / P3-T04)
# Create two recurring products in the Stripe Dashboard and paste their Price IDs.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...          # from the webhook endpoint you register
STRIPE_PRICE_FAMILY=price_...            # Price ID for the Família plan
STRIPE_PRICE_PREMIUM=price_...           # Price ID for the Premium plan
