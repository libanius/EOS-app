# Supabase
NEXT_PUBLIC_SUPABASE_URL=your_supabase_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Site URL — used for auth redirects (email confirmation, password recovery)
# Development: http://localhost:3000
# Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-5

# Sentry (Phase 10)
SENTRY_DSN=your_sentry_dsn

# Stripe billing (D-042 / P3-T04)
# Create two recurring products in the Stripe Dashboard and paste their Price IDs.
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...          # from the webhook endpoint you register
STRIPE_PRICE_FAMILY=price_...            # Price ID for the Família plan
STRIPE_PRICE_PREMIUM=price_...           # Price ID for the Premium plan

# ─── Hazard providers (D-043) ─────────────────────────────────────────────────
# Keyless providers (NWS, USGS, NHC, Open-Meteo) need NOTHING here — already live.
# The ones below stay NOT_CONFIGURED until filled. Never commit real secrets.
# See docs/hazard-provider-setup.md.

# Apple WeatherKit — primary forecast + minute nowcast (server-side JWT only)
WEATHERKIT_TEAM_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_PRIVATE_KEY=

# AccuWeather MinuteCast — nowcast fallback
ACCUWEATHER_API_KEY=

# Xweather — lightning strike detection
XWEATHER_CLIENT_ID=
XWEATHER_CLIENT_SECRET=

# USGS ShakeAlert — earthquake early warning (requires licensing/partnership)
SHAKEALERT_ENABLED=false
SHAKEALERT_ENDPOINT=
SHAKEALERT_TOKEN=

# FEMA IPAWS-OPEN — public CAP alerts (requires COG ID + FEMA authorization)
FEMA_IPAWS_ENABLED=false
FEMA_IPAWS_COG_ID=
FEMA_IPAWS_PIN=
